# Copie para .env (que NÃO vai para o git) ou defina no painel do provedor.

# Chave para assinar sessões. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria

# Banco de dados. Sem esta variável, usa SQLite em instance/detective.db (só para desenvolvimento).
# Produção: Postgres, ex.: postgresql://usuario:senha@host:5432/banco
DATABASE_URL=

# Opcionais
SEARCH_WORKERS=2
SITE_TIMEOUT=15
FLASK_DEBUG=0
